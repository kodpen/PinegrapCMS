{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "channelsEnabled": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/tools/install_git_hooks.sh\" ]; then bash \"$CLAUDE_PROJECT_DIR/tools/install_git_hooks.sh\" --session-start; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Monitor",
      "Bash",
      "mcp__github__issue_write",
      "Bash(gh api repos/kodpen/pinegrapcms/issues -f title=:*)"
    ]
  }
}
