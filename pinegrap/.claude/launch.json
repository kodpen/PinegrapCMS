{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "PineGrap (IIS - HTTP)",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-Command", "Start-Process 'http://localhost/pinegrap/'"],
      "port": 80,
      "autoPort": false
    },
    {
      "name": "PineGrap (IIS - HTTPS)",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-Command", "Start-Process 'https://localhost/pinegrap/'"],
      "port": 443,
      "autoPort": false
    }
  ]
}
