			count: 1
			path: ../pinegrap/get_catalog.php

		-
			message: '#^Undefined variable\: \$output_image$#'
			identifier: variable.undefined
			count: 1
			path: ../pinegrap/get_catalog.php

		-
			message: '#^Undefined variable\: \$output_price$#'
			identifier: variable.undefined
			count: 1
			path: ../pinegrap/get_catalog.php

		-
			message: '#^Undefined variable\: \$output_short_description$#'
			identifier: variable.undefined
			count: 1
			path: ../pinegrap/get_catalog.php

		-
			message: '#^Function pfpro_process not found\.$#'
			identifier: function.notFound
			count: 2
			path: ../pinegrap/submit_order.php
