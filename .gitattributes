# Shell scripts must keep LF endings: the sandbox runs them with bash.
*.sh text eol=lf

# Language files must keep LF endings on every checkout, core.autocrlf=true
# included: tools/check_lang.php and the tests compare each shard byte for
# byte with the form tools/tr_add.php writes (docs/memory/core/lang-files.md).
pinegrap/includes/local/*.json text eol=lf
pinegrap/includes/local/*/*.json text eol=lf

# Vendor API test vectors are compared byte for byte with the vendor's copies
# (docs/memory/plans/kodpen-vendor-api-client-steps.md, P1): keep LF everywhere.
tests/fixtures/vendor_api/*.json text eol=lf
